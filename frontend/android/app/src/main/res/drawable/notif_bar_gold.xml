<?xml version="1.0" encoding="utf-8"?>
<!-- 6.0 — a slim rounded progress bar for a notification card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background"><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#33FFD60A" /></shape></item>
    <item android:id="@android:id/progress"><clip><shape android:shape="rectangle"><corners android:radius="3dp" />
        <gradient android:angle="0" android:startColor="#FFFFD60A" android:endColor="#FFFFE88A" /></shape></clip></item>
</layer-list>
