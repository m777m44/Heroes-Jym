        android:format12Hour="EEEE d MMMM" android:format24Hour="EEEE d MMMM" android:maxLines="1" android:textColor="#FFC7C7CC" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/n_status" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginEnd="6dp" android:background="@drawable/notif_pill"
        android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="7dp" android:paddingEnd="7dp" android:textColor="#FF30D158" android:textSize="10.5sp" android:textStyle="bold" />
    <TextClock android:id="@+id/n_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
        android:format12Hour="hh:mm:ss a" android:format24Hour="HH:mm:ss" android:maxLines="1" android:textColor="#FFF2F2F7" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/n_pause" android:layout_width="28dp" android:layout_height="22dp" android:layout_marginStart="8dp" android:background="@drawable/notif_icon_btn" android:gravity="center">
        <ImageView android:id="@+id/n_pause_i" android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_n_pause" />
    </LinearLayout>
</LinearLayout>
