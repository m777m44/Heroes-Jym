<?xml version="1.0" encoding="utf-8"?>
<!-- 2.7.0 — THE notification (collapsed): steps | water side by side, "+" your usual
     container. The clock shows instead of the water half when water isn't in the bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_live_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_steps"
                android:tint="#FF30D158" />

            <TextView
                android:id="@+id/n_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF30D158"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/n_pct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/n_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/notif_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ws_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_drop" />

            <TextView
                android:id="@+id/ws_ml"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF64D2FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ws_pct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ws_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/notif_progress_water" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ws_add"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/notif_chip_sel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_n_plus" />

        <ImageView
            android:id="@+id/ws_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextClock
        android:id="@+id/n_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFeatureSettings="tnum"
        android:format12Hour="hh:mm:ss"
        android:format24Hour="HH:mm:ss"
        android:textColor="#FFF2F2F7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
