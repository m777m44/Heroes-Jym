<?xml version="1.0" encoding="utf-8"?>
<!-- 5.0 — the water panel (expanded) while the step counter is off: the water ring with %, the amount, where the goal comes from, the reminder's exercise line, the four containers, Undo · Edit · In 15 min. Filled by WaterReminder.fill(); chip ids shared with notif_live_big.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/notif_water_card" android:paddingStart="12dp" android:paddingTop="9dp" android:paddingEnd="12dp" android:paddingBottom="9dp"
    android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:layout_width="58dp" android:layout_height="58dp">
    <ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="false" android:max="1000"
        android:minHeight="58dp" android:maxHeight="58dp" android:minWidth="58dp" android:maxWidth="58dp"
        android:mirrorForRtl="false" android:progressDrawable="@drawable/notif_ring_water" />
    <ProgressBar android:id="@+id/w_ring_ok" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="false" android:max="1000"
        android:minHeight="58dp" android:maxHeight="58dp" android:minWidth="58dp" android:maxWidth="58dp"
        android:mirrorForRtl="false" android:progressDrawable="@drawable/notif_ring_water_ok" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/w_ring_i" android:layout_width="12dp" android:layout_height="12dp" android:contentDescription="@null" android:src="@drawable/ic_w_drop" android:tint="#FF64D2FF" />
<TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="11.5sp" android:textStyle="bold" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum"/>
    </LinearLayout>
</FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/w_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum"/>
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end"
            android:includeFontPadding="false" android:maxLines="2" android:textColor="#FFC7C7CC" android:textSize="11sp" />
        <TextView android:id="@+id/w_move" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end"
            android:includeFontPadding="false" android:maxLines="2" android:textColor="#FFFFB340" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/w_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/w_c0" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
    android:background="@drawable/notif_chip" android:gravity="center" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/w_i0" android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:orientation="vertical">
        <TextView android:id="@+id/w_n0" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m0" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FF64D2FF" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum"/>
    </LinearLayout>
</LinearLayout><LinearLayout android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
    android:layout_marginStart="5dp" android:background="@drawable/notif_chip" android:gravity="center" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/w_i1" android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:orientation="vertical">
        <TextView android:id="@+id/w_n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m1" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FF64D2FF" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum"/>
    </LinearLayout>
</LinearLayout><LinearLayout android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
    android:layout_marginStart="5dp" android:background="@drawable/notif_chip" android:gravity="center" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/w_i2" android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:orientation="vertical">
        <TextView android:id="@+id/w_n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m2" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FF64D2FF" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum"/>
    </LinearLayout>
</LinearLayout><LinearLayout android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
    android:layout_marginStart="5dp" android:background="@drawable/notif_chip" android:gravity="center" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/w_i3" android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:orientation="vertical">
        <TextView android:id="@+id/w_n3" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m3" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FF64D2FF" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum"/>
    </LinearLayout>
</LinearLayout>
    
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
    <LinearLayout android:id="@+id/w_undo" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" 
    android:background="@drawable/notif_icon_btn" android:gravity="center" android:orientation="horizontal">
    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_w_undo" />
    <TextView android:id="@+id/w_undo_t" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="11.5sp" android:textStyle="bold" android:layout_marginStart="5dp"/>
</LinearLayout>
    <LinearLayout android:id="@+id/w_edit" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="5dp"
    android:background="@drawable/notif_icon_btn" android:gravity="center" android:orientation="horizontal">
    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_w_edit" />
    <TextView android:id="@+id/w_edit_t" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="11.5sp" android:textStyle="bold" android:layout_marginStart="5dp"/>
</LinearLayout>
    <LinearLayout android:id="@+id/w_snooze" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="5dp"
    android:background="@drawable/notif_icon_btn" android:gravity="center" android:orientation="horizontal" android:visibility="gone">
    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_w_snooze" />
    <TextView android:id="@+id/w_snooze_t" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="#FFF2F2F7" android:textSize="11.5sp" android:textStyle="bold" android:layout_marginStart="5dp"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
