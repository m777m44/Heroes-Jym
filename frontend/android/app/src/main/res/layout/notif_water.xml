<?xml version="1.0" encoding="utf-8"?>
<!-- 2.6 — the water panel in the notifications (expanded). Everything works with the app
     closed: each container adds itself, Undo takes the last drink back, Edit opens the Water
     screen; on a reminder the exercise line and "In 15 min" show too. Only views RemoteViews
     allows are used. Filled by WaterReminder.fill(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_water_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_drop" />

        <TextView
            android:id="@+id/w_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#FFF2F2F7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#FF64D2FF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/notif_progress_water" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF9FB7D9"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/w_move"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/notif_move"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFD60A"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/notif_chip"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/w_i0"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_m0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF64D2FF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/notif_chip"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/w_i1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_m1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF64D2FF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/notif_chip"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/w_i2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_m2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF64D2FF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/notif_chip"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/w_i3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_m3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF64D2FF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_undo"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/notif_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_undo" />

            <TextView
                android:id="@+id/w_undo_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_edit"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/notif_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_edit" />

            <TextView
                android:id="@+id/w_edit_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_snooze"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:background="@drawable/notif_chip"
            android:gravity="center"
            android:orientation="horizontal" android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_snooze" />

            <TextView
                android:id="@+id/w_snooze_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:textColor="#FFF2F2F7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
