<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 2.8 — Android Backup (key/value): MjBackupAgent backs up only the data copy that the
         app writes while you're signed in with Google, to the phone's Google account, and it
         comes back when the app is installed again or on a new phone. No key is needed any
         more; the placeholder below is for older devices that still look for one. -->
    <application
        android:allowBackup="true"
        android:backupAgent=".account.MjBackupAgent"
        android:restoreAnyVersion="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data android:name="com.google.android.backup.api_key" android:value="unused" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MAHDI-JYM 2.1 — all-day step counter: a foreground service (type "health") that reads
             the hardware step counter with the phone locked, and keeps the live notification and
             the home-screen widget current. -->
        <service
            android:name=".steps.StepCounterService"
            android:exported="false"
            android:foregroundServiceType="health|shortService" />

        <receiver
            android:name=".steps.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Restarts the counter if the system or a battery "cleaner" killed it (see Watchdog.java). -->
        <receiver
            android:name=".steps.Watchdog"
            android:exported="false" />

        <!-- MAHDI-JYM 2.5 — water reminders with a short exercise, scheduled natively so they
             arrive (and "Drank it" works) with the app closed. -->
        <receiver
            android:name=".steps.WaterReminder"
            android:exported="false" />

        <!-- MAHDI-JYM 2.10 — workout / home-workout reminders: heads-up with a light vibration. -->
        <receiver
            android:name=".steps.WorkoutReminder"
            android:exported="false" />

        <!-- MAHDI-JYM 10.0 — "My schedule" reminders: everything planned for the block, with
             Done ✓ and In 10 min that work with the app closed. -->
        <receiver
            android:name=".steps.PlanReminder"
            android:exported="false" />

        <!-- The full-screen celebration: over the lock screen (full-screen intent) and, with
             "Display over other apps", on top of whatever is open. Own task, no recents entry. -->
        <activity
            android:name=".steps.CelebrationActivity"
            android:exported="false"
            android:theme="@style/CelebrationTheme"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <receiver
            android:name=".steps.StepWidget"
            android:exported="true"
            android:label="@string/widget_steps_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <!-- 7.0: the Today widget — steps, water and food rings with quick water buttons -->
        <receiver
            android:name=".steps.TodayWidget"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Workout-day reminder: lets the local-notifications plugin fire at the exact minute
         on Android 12+. Where it isn't granted, scheduling silently falls back to inexact
         alarms — the reminder still arrives, just not to the minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- MAHDI-JYM 2.0 — step counter: reads the hardware step sensor (Android 10+ asks the
         user at runtime). Declared by the pedometer plugin too; listed here so the app's own
         manifest says what it uses. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Ongoing step notification + reminders (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- All-day step counter service (2.1): runs in the foreground with its live notification;
         Android 14+ requires the "health" service type and its permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Restart the step counter after a reboot, if it was running. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Keep counting in the background": opens the system dialog that exempts the app from
         battery optimisation, so aggressive OEM battery savers don't kill the counter. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
    <!-- Haptic tick every 1,000 steps. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional "GPS speed" switch on the walking screen (off by default). Positions are used
         on the device to compute speed and are never stored or sent anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 2.5 — the goal celebration may cover the lock screen (Android 14+ lets the user turn
         this off per app), and — only if the user allows "Display over other apps" in
         Settings — open on top of another app. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- 8.0 — "Google Drive, no setup" (DriveFilePlugin): lets the app see whether the Google
         Drive app is installed (Android 11+ hides other apps unless they are named here), so it
         can suggest installing it instead of showing a picker without Drive in it. -->
    <queries>
        <package android:name="com.google.android.apps.docs" />
    </queries>
</manifest>
